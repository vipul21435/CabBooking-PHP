# The application is served from the repository root, so without these rules
# /.env returns the database credentials and /database/01-schema.sql returns the
# whole schema including password hashes.
#
# Everything here is expressed with mod_rewrite rather than <Directory> or
# <DirectoryMatch>, which Apache only accepts in the server configuration and
# refuses outright in a .htaccess file.

<IfModule mod_rewrite.c>
    RewriteEngine on

    # Directories that are part of the project but must never be served.
    RewriteRule ^(database|docker|\.github|\.git)(/|$) - [F,L]

    # Dotfiles, and file types that are source or configuration rather than
    # something a browser should receive.
    RewriteRule (^|/)\. - [F,L]
    RewriteRule \.(env|sql|md|lock|ya?ml|dist|log|ini|bak)$ - [F,L]

    # Everything else that is not a real file falls through to the router.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$    /index.php/$2/?page=$1   [L]
</IfModule>

<IfModule mod_headers.c>
    # The template set Access-Control-Allow-Origin "*" here, on an application
    # whose authentication is a session cookie. There is no cross-origin caller,
    # so it is removed rather than narrowed.
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
