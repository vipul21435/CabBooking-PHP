# ---------------------------------------------------------------------------
# Copy to .env and adjust. .env is git-ignored and must never be committed.
# ---------------------------------------------------------------------------

# Where the app is served from, with a trailing slash.
APP_BASE_URL=http://localhost:8000/

# Show PHP errors in the browser. Never true in production.
APP_DEBUG=true

APP_TIMEZONE=Asia/Kolkata

# Database. These match docker-compose.yml so `docker compose up` just works.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cbsphp
DB_USER=cbs
DB_PASSWORD=cbs_local_password
